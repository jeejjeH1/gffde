# --- FundingEdge configuration (no real credentials here) ---

# Optional: PostgreSQL for locally collected funding history. App works without it.
# DATABASE_URL=postgres://user:password@localhost:5432/fundingedge
# Days of locally collected observations to keep.
HISTORY_RETENTION_DAYS=90

# Secret required (Authorization: Bearer <secret>) by /api/collect and /api/alerts/check.
# Generate a long random string. Those endpoints are disabled when unset.
# CRON_SECRET=

# Telegram alerts (server-side only; never exposed to the browser).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Alert thresholds (USD net return on ALERT_NOTIONAL_USD over ALERT_HORIZON).
ALERT_NOTIONAL_USD=10000
ALERT_HORIZON=24h
ALERT_MIN_NET_USD=15
ALERT_MAX_DATA_AGE_SEC=90
ALERT_DEDUPE_MINUTES=120

# Seconds after which a market snapshot is considered stale.
STALE_AFTER_SEC=90

# Demonstration mode: serves clearly labelled SYNTHETIC data instead of live data.
# Only for UI development when exchanges are unreachable. Never use in production.
# FUNDINGEDGE_DEMO=1
